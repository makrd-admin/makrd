# Copy this file to .env.local and fill in real values.
# Find these in the Supabase dashboard: Project Settings -> API.
# .env.local is git-ignored — never commit real credentials.

# Project URL (Project Settings -> API -> Project URL). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key (Project Settings -> API -> Project API keys -> anon public).
# Safe to expose to the browser — Row Level Security policies protect the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (Project Settings -> API -> Project API keys -> service_role).
# SERVER-ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_,
# never send to the browser, never commit. Used by the Razorpay webhook, which
# has no user session to authenticate a request with.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay (Dashboard -> Settings -> API Keys). Key ID is safe to expose to the
# browser (Razorpay Checkout needs it client-side); Key Secret is SERVER-ONLY,
# used to create orders via the Orders API. Test-mode keys work without full
# KYC/business verification — start there.
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Razorpay webhook secret (Dashboard -> Settings -> Webhooks -> add
# https://<your-domain>/api/razorpay/webhook, subscribe to "payment.captured").
# SERVER-ONLY — verifies that webhook requests actually came from Razorpay.
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
